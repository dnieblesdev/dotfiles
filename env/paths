# ──────────────────────────────────────────────
# PATH y variables de entorno de herramientas
# ──────────────────────────────────────────────

# Helpers shared by Bash and Zsh.
[ -f "$HOME/.dotfiles/env/path.sh" ] && . "$HOME/.dotfiles/env/path.sh"

# Rust / Cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Java / Android SDK
export JAVA_HOME="/home/dniebles/development/jdk"
export ANDROID_HOME="/home/dniebles/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
path_prepend "$ANDROID_HOME/platform-tools"
path_prepend "$ANDROID_HOME/cmdline-tools/latest/bin"
path_prepend "$JAVA_HOME/bin"

# Flutter
path_prepend "/home/dniebles/development/flutter/bin"

# opencode
path_prepend "/home/dniebles/.opencode/bin"

# gentle-ai
path_append "/home/dniebles/.local/bin"
