# Shared optional environment for Bash and Zsh.
# Machine-specific roots must be supplied by the caller, not committed here.
. "${DOTFILES_ROOT:-$HOME/.dotfiles}/env/path.sh"

[ ! -f "$HOME/.cargo/env" ] || . "$HOME/.cargo/env"
. "${DOTFILES_ROOT:-$HOME/.dotfiles}/env/go"

if [ -n "${JAVA_HOME:-}" ] && [ -d "$JAVA_HOME/bin" ]; then
    path_prepend "$JAVA_HOME/bin"
fi
# Accept either Android spelling without replacing a caller's explicit value.
if [ -n "${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" ]; then
    export ANDROID_HOME="${ANDROID_HOME:-$ANDROID_SDK_ROOT}"
    export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
    [ ! -d "$ANDROID_HOME/platform-tools" ] || path_prepend "$ANDROID_HOME/platform-tools"
    [ ! -d "$ANDROID_HOME/cmdline-tools/latest/bin" ] || path_prepend "$ANDROID_HOME/cmdline-tools/latest/bin"
fi
if [ -n "${FLUTTER_HOME:-}" ] && [ -d "$FLUTTER_HOME/bin" ]; then
    path_prepend "$FLUTTER_HOME/bin"
fi
[ ! -d "$HOME/.opencode/bin" ] || path_prepend "$HOME/.opencode/bin"
path_append "$HOME/.local/bin"
