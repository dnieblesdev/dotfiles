# ──────────────────────────────────────────────
# NVM (Node Version Manager)
# ──────────────────────────────────────────────

export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    if [ -n "${ZSH_VERSION-}" ]; then
        (( $+functions[nvm] )) || . "$NVM_DIR/nvm.sh"
    else
        declare -F nvm >/dev/null || . "$NVM_DIR/nvm.sh"
    fi
fi
if [ -s "$NVM_DIR/bash_completion" ]; then
    if [ -n "${ZSH_VERSION-}" ]; then
        (( $+functions[__nvm] )) || . "$NVM_DIR/bash_completion"
    else
        declare -F __nvm >/dev/null || . "$NVM_DIR/bash_completion"
    fi
fi
