# ──────────────────────────────────────────────
# Optional interactive tools
# ──────────────────────────────────────────────

if command -v starship >/dev/null 2>&1 && (( ! $+functions[prompt_starship_precmd] )); then
    eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1 && (( ! $+functions[__zoxide_z] )); then
    eval "$(zoxide init zsh)"
fi
