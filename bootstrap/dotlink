#!/usr/bin/env bash
# dotlink — mini-stow personal
# Enlaza dotfiles de ~/.dotfiles/<modulo>/ a $HOME
#
# Uso:
#   dotlink bash              # linkea ~/.dotfiles/bash/* → ~/
#   dotlink git env           # linkea git y env
#   dotlink --all             # linkea todos los módulos principales
#   dotlink --list            # muestra qué está linkeado y qué no
#   dotlink --dry-run bash    # muestra qué haría sin ejecutar
#   dotlink --delete bash     # remueve symlinks de bash

set -euo pipefail

DOTFILES="$HOME/.dotfiles"
DRY_RUN=false
DELETE_MODE=false
LIST_MODE=false

usage() {
    sed -n '3,10p' "$0"
    exit 0
}

log()    { echo -e "  \033[32m✓\033[0m $1"; }
warn()   { echo -e "  \033[33m⚠\033[0m $1"; }
info()   { echo -e "  \033[36m→\033[0m $1"; }
dry()    { echo -e "  \033[35m◇\033[0m $1"; }

link_file() {
    local src="$1"
    local target="$2"
    local name

    name="$(basename "$src")"

    # Si el target existe y es el symlink correcto → skip
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
        return 0
    fi

    # Si existe y NO es symlink → warning
    if [ -e "$target" ] && [ ! -L "$target" ]; then
        warn "$target existe y NO es symlink. Movélo o borralo manual."
        return 1
    fi

    # Si es symlink pero apunta a otro lado → reemplazar
    if [ -L "$target" ]; then
        rm "$target"
    fi

    if [ "$DRY_RUN" = true ]; then
        dry "ln -s $src $target"
        return 0
    fi

    ln -s "$src" "$target"
    log "$name → $target"
}

ensure_real_dir() {
    local dir="$1"

    if [ -d "$dir" ] && [ ! -L "$dir" ]; then
        return 0
    fi

    if [ -e "$dir" ] || [ -L "$dir" ]; then
        warn "$dir existe pero NO es un directorio real. Movélo o borralo manual."
        return 1
    fi

    if [ "$DRY_RUN" = true ]; then
        dry "mkdir -p $dir"
        return 0
    fi

    mkdir -p "$dir"
    log "Creado $dir"
}

link_module() {
    local module="$1"
    local src_dir="$DOTFILES/$module"

    if [ ! -d "$src_dir" ]; then
        warn "Módulo '$module' no encontrado en $DOTFILES"
        return 1
    fi

    local count=0

    # Linkear dotfiles (archivos que empiezan con .)
    while IFS= read -r -d '' file; do
        local basename
        basename="$(basename "$file")"
        link_file "$file" "$HOME/$basename" && ((count++)) || true
    done < <(find "$src_dir" -maxdepth 1 -name '.*' -type f -print0 2>/dev/null)

    # Linkear contenido de directorios dot anidados (ej: .config/starship.toml)
    # El directorio padre en $HOME se crea como directorio real; nunca se symlinkea completo.
    while IFS= read -r -d '' dir; do
        local rel_path="${dir#$src_dir/}"   # ej: .config/gh
        local target_dir="$HOME/$rel_path"

        if ensure_real_dir "$target_dir"; then
            while IFS= read -r -d '' inner; do
                local inner_name
                inner_name="$(basename "$inner")"
                link_file "$inner" "$target_dir/$inner_name" && ((count++)) || true
            done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -type f -o -type d \) -print0 2>/dev/null)
        fi
    done < <(find "$src_dir" -mindepth 1 -maxdepth 1 -type d -name '.*' -print0 2>/dev/null)

    if [ "$count" -eq 0 ]; then
        info "Nada nuevo que linkear en '$module'"
    fi
}

delete_module() {
    local module="$1"
    local src_dir="$DOTFILES/$module"

    if [ ! -d "$src_dir" ]; then
        warn "Módulo '$module' no encontrado"
        return 1
    fi

    # Remover symlinks de dotfiles
    while IFS= read -r -d '' file; do
        local basename target
        basename="$(basename "$file")"
        target="$HOME/$basename"
        if [ -L "$target" ] && [ "$(readlink "$target")" = "$file" ]; then
            rm "$target"
            log "Removido $target"
        fi
    done < <(find "$src_dir" -maxdepth 1 -name '.*' -type f -print0 2>/dev/null)

    # Remover symlinks dentro de directorios dot anidados, sin borrar el directorio padre real.
    while IFS= read -r -d '' dir; do
        local rel_path target_dir
        rel_path="${dir#$src_dir/}"
        target_dir="$HOME/$rel_path"
        while IFS= read -r -d '' inner; do
            local inner_name target
            inner_name="$(basename "$inner")"
            target="$target_dir/$inner_name"
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$inner" ]; then
                rm "$target"
                log "Removido $target"
            fi
        done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -type f -o -type d \) -print0 2>/dev/null)
    done < <(find "$src_dir" -mindepth 1 -maxdepth 1 -type d -name '.*' -print0 2>/dev/null)
}

list_status() {
    local all_modules=()
    for d in "$DOTFILES"/*/; do
        [ -d "$d" ] || continue
        local name
        name="$(basename "$d")"
        [ "$name" = "bootstrap" ] && continue  # skip bootstrap/
        all_modules+=("$name")
    done

    echo -e "\033[1mEstado de dotfiles:\033[0m"
    for module in "${all_modules[@]}"; do
        local linked=0 pending=0
        while IFS= read -r -d '' file; do
            local basename target
            basename="$(basename "$file")"
            target="$HOME/$basename"
            if [ -L "$target" ] && [ "$(readlink "$target")" = "$file" ]; then
                linked=$((linked + 1))
            else
                pending=$((pending + 1))
            fi
        done < <(find "$DOTFILES/$module" -maxdepth 1 -name '.*' -type f -print0 2>/dev/null)
        while IFS= read -r -d '' dir; do
            local rel_path target_dir
            rel_path="${dir#$DOTFILES/$module/}"
            target_dir="$HOME/$rel_path"
            while IFS= read -r -d '' inner; do
                local inner_name target
                inner_name="$(basename "$inner")"
                target="$target_dir/$inner_name"
                if [ -L "$target" ] && [ "$(readlink "$target")" = "$inner" ]; then
                    linked=$((linked + 1))
                else
                    pending=$((pending + 1))
                fi
            done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -type f -o -type d \) -print0 2>/dev/null)
        done < <(find "$DOTFILES/$module" -mindepth 1 -maxdepth 1 -type d -name '.*' -print0 2>/dev/null)
        echo "  $module: $linked linkeado(s), $pending pendiente(s)"
    done
}

# --- MAIN ---

case "${1:-}" in
    -h|--help) usage ;;
    --list)    LIST_MODE=true ; shift ;;
    --dry-run) DRY_RUN=true ; shift ;;
    --delete)  DELETE_MODE=true ; shift ;;
    --all)     set -- bash git zsh config env wsl linux ;;
esac

if [ "$LIST_MODE" = true ]; then
    list_status
    exit 0
fi

if [ $# -eq 0 ]; then
    usage
fi

for module in "$@"; do
    [ "$module" = "bootstrap" ] && continue
    echo -e "\033[1m[$module]\033[0m"
    if [ "$DELETE_MODE" = true ]; then
        delete_module "$module"
    else
        link_module "$module"
    fi
done
